<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements, used only when FR_SIGN_IDENTITY names a
  Developer ID certificate. The first three are what Chromium needs to run at
  all under the hardened runtime; there is deliberately nothing else here.

  Focus Reader is not App-Sandboxed. It does not need to be for Developer ID
  distribution, and the sandbox would break the two things the app exists to do:
  watch an inbox directory outside the container, and register global shortcuts.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
